{
  "name": "@patine-ui/mcp",
  "version": "0.0.0",
  "description": "MCP server for Patine UI: lets Claude Code, Cursor, Windsurf and other coding agents list, read and search the patine-ui docs and find icons, matched to the version installed in your project. Zero dependencies.",
  "license": "MIT",
  "author": "Patine UI <support@patine.dev>",
  "homepage": "https://patine.dev/docs/resources/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patine-ui/patine.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "react native",
    "patine",
    "ai agents",
    "claude code",
    "cursor",
    "windsurf",
    "react-native-mcp",
    "expo",
    "icons"
  ],
  "bin": {
    "patine-mcp": "src/index.js"
  },
  "main": "src/docs.js",
  "scripts": {
    "pro": "node scripts/pro.js"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
